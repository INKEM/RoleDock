{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:roledock:protocol:0.1:workspace-service-info",
  "title": "WorkspaceServiceInfo",
  "description": "Owner-facing service runtime projection returned by workspace.info (G1). Non-sensitive only: no argv, no filesystem paths, no credentials.",
  "type": "object",
  "properties": {
    "workspace_id": { "$ref": "#/$defs/id" },
    "service": {
      "type": "object",
      "properties": {
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "pid": { "type": "integer", "minimum": 1 },
        "started_at": { "$ref": "#/$defs/timestamp" },
        "adapter": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
        "runtime": { "type": "string", "minLength": 1, "maxLength": 32 }
      },
      "required": ["version", "pid", "started_at", "adapter", "runtime"],
      "additionalProperties": false
    }
  },
  "required": ["workspace_id", "service"],
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}
