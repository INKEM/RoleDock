{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:roledock:protocol:0.1:host-session-discovery",
  "title": "HostSessionDiscovery",
  "description": "Read-only host session discovery candidates (desktop-gui-contract §9, G3). Discovery never creates, attaches or consumes a model turn; registered_external_session_id marks sessions already registered in this workspace.",
  "type": "object",
  "properties": {
    "workspace_id": { "$ref": "#/$defs/id" },
    "observed_at": { "$ref": "#/$defs/timestamp" },
    "adapter": { "type": "string", "minLength": 1 },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "host_session_id": { "type": "string", "minLength": 1 },
          "title": { "type": ["string", "null"] },
          "status": { "type": ["string", "null"] },
          "kind": { "type": ["string", "null"] },
          "updated_at": { "type": ["string", "null"] },
          "registered_external_session_id": { "type": ["string", "null"] }
        },
        "required": ["host_session_id", "title", "status", "kind", "updated_at", "registered_external_session_id"],
        "additionalProperties": false
      }
    }
  },
  "required": ["workspace_id", "observed_at", "adapter", "items"],
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}
