{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:roledock:protocol:0.1:service-control-operation",
  "type": "object",
  "properties": {
    "operation": {
      "enum": [
        "connections.trust",
        "externalSessions.register",
        "externalSessions.list",
        "authorizations.recordHuman",
        "authorizations.recordOwner",
        "authorizations.revoke",
        "authorizations.submitHumanEvent",
        "authorizations.confirmations",
        "authorizations.pendingEvents",
        "externalSessions.discover",
        "sessions.listBindings",
        "sessions.listAttempts",
        "sessions.listLoads",
        "authorizations.revokePreview",
        "documents.list",
        "documents.read",
        "documents.listRevisions",
        "documents.listCandidates",
        "checkpoints.list",
        "checkpoints.get",
        "requests.listInbox",
        "requests.get",
        "requests.cancelByOwner",
        "requests.listCleanup",
        "artifacts.read"
      ]
    },
    "input": {
      "type": "object"
    }
  },
  "required": [
    "operation",
    "input"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "connections.trust"
          }
        }
      },
      "then": {
        "properties": {
          "input": {
            "type": "object",
            "properties": {
              "subject": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "capability_ceiling": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
                },
                "uniqueItems": true
              }
            },
            "required": [
              "subject",
              "capability_ceiling"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "externalSessions.register"
          }
        }
      },
      "then": {
        "properties": {
          "input": {
            "type": "object",
            "properties": {
              "host_session_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "required": [
              "host_session_id"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "externalSessions.list"
          }
        }
      },
      "then": {
        "properties": {
          "input": {
            "type": "object",
            "description": "G-min: owner-face read view for the desktop confirmation surface (registered sessions with their live authorization summary). Read-only; grants nothing.",
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "authorizations.recordHuman"
          }
        }
      },
      "then": {
        "properties": {
          "input": {
            "type": "object",
            "properties": {
              "external_session_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "event_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "required": [
              "external_session_id",
              "event_ref"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "authorizations.recordOwner"
          }
        }
      },
      "then": {
        "properties": {
          "input": {
            "type": "object",
            "properties": {
              "external_session_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "event_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "actor_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "role_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
                },
                "uniqueItems": true
              },
              "inherit": {
                "enum": [
                  "initialize",
                  "takeover"
                ]
              },
              "expires_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "external_session_id",
              "event_ref",
              "actor_id",
              "role_id",
              "capabilities",
              "inherit",
              "expires_at"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "authorizations.revoke"
          }
        }
      },
      "then": {
        "properties": {
          "input": {
            "type": "object",
            "properties": {
              "authorization_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              }
            },
            "required": [
              "authorization_id"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "authorizations.submitHumanEvent"
          }
        }
      },
      "then": {
        "properties": {
          "input": {
            "type": "object",
            "description": "Owner-face trusted writer only (CLI console now, GUI confirm in P6-G-min). The event facts mirror the human-authorization-event schema; workspace_id is filled by the service, not the caller. The service stores the record and matches it to the registered external session; storage alone grants nothing (recordHuman still validates via the adapter port).",
            "properties": {
              "external_session_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "host_session_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "connection_subject": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "event_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "actor_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "role_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
                },
                "uniqueItems": true
              },
              "inherit": {
                "enum": [
                  "initialize",
                  "takeover"
                ]
              },
              "expires_at": {
                "type": "string",
                "format": "date-time"
              },
              "entry": {
                "enum": [
                  "cli-console",
                  "gui-confirm"
                ]
              },
              "recorded_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "external_session_id",
              "host_session_id",
              "connection_subject",
              "event_ref",
              "actor_id",
              "role_id",
              "capabilities",
              "inherit",
              "expires_at",
              "entry",
              "recorded_at"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "authorizations.confirmations"
          }
        }
      },
      "then": {
        "properties": {
          "input": {
            "type": "object",
            "properties": {
              "cursor": {
                "type": "string"
              },
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 200
              },
              "external_session_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "authorizations.pendingEvents"
          }
        }
      },
      "then": {
        "properties": {
          "input": {
            "type": "object",
            "description": "G3 trusted face: subject comes from the trusted principal; input must be empty.",
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "externalSessions.discover"
          }
        }
      },
      "then": {
        "properties": {
          "input": {
            "type": "object",
            "description": "G3 trusted face: read-only host session discovery; input must be empty.",
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "sessions.listBindings"
          }
        }
      },
      "then": {
        "properties": {
          "input": {
            "type": "object",
            "description": "G4 owner face: paged binding read view (desktop-gui-contract §2.3). Projection only.",
            "properties": {
              "cursor": { "type": "string" },
              "limit": { "type": "integer", "minimum": 1, "maximum": 200 },
              "external_session_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "sessions.listAttempts"
          }
        }
      },
      "then": {
        "properties": {
          "input": {
            "type": "object",
            "description": "G4 owner face: paged anchor-attempt read view (desktop-gui-contract §2.3). Projection only.",
            "properties": {
              "cursor": { "type": "string" },
              "limit": { "type": "integer", "minimum": 1, "maximum": 200 },
              "external_session_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "sessions.listLoads"
          }
        }
      },
      "then": {
        "properties": {
          "input": {
            "type": "object",
            "description": "G4 owner face: paged material-load read view (desktop-gui-contract §2.3). Projection only.",
            "properties": {
              "cursor": { "type": "string" },
              "limit": { "type": "integer", "minimum": 1, "maximum": 200 },
              "external_session_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "authorizations.revokePreview"
          }
        }
      },
      "then": {
        "properties": {
          "input": {
            "type": "object",
            "description": "G4 owner face: read-only revoke impact preview (desktop-gui-contract §2.3); revoking is a separate explicit write.",
            "properties": {
              "authorization_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              }
            },
            "required": ["authorization_id"],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "documents.list"
          }
        }
      },
      "then": {
        "properties": {
          "input": {
            "type": "object",
            "description": "G5 owner face: paged knowledge directory read view (desktop-gui-contract §2.3); metadata only, bodies come from documents.read. Projection only.",
            "properties": {
              "cursor": { "type": "string" },
              "limit": { "type": "integer", "minimum": 1, "maximum": 200 },
              "role_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "documents.read"
          }
        }
      },
      "then": {
        "properties": {
          "input": {
            "type": "object",
            "description": "G5 owner face: one revision's content per the §3.2 visibility matrix — private/role bodies stay metadata+hash with body_included:false.",
            "properties": {
              "role_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "document_key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "revision": { "type": "integer", "minimum": 1 }
            },
            "required": ["role_id", "document_key"],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "documents.listRevisions"
          }
        }
      },
      "then": {
        "properties": {
          "input": {
            "type": "object",
            "description": "G5 owner face: immutable revision history (metadata only) for one document.",
            "properties": {
              "cursor": { "type": "string" },
              "limit": { "type": "integer", "minimum": 1, "maximum": 200 },
              "role_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "document_key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              }
            },
            "required": ["role_id", "document_key"],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "documents.listCandidates"
          }
        }
      },
      "then": {
        "properties": {
          "input": {
            "type": "object",
            "description": "G5 owner face: paged candidate read view with full candidate bodies; baseline bodies follow the visibility matrix.",
            "properties": {
              "cursor": { "type": "string" },
              "limit": { "type": "integer", "minimum": 1, "maximum": 200 },
              "role_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "source": { "enum": ["documents.propose", "knowledge.import", "request.result"] }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "checkpoints.list"
          }
        }
      },
      "then": {
        "properties": {
          "input": {
            "type": "object",
            "description": "G5 owner face: paged checkpoint summaries — handoff summary metadata and todo overview; full body behind checkpoints.get.",
            "properties": {
              "cursor": { "type": "string" },
              "limit": { "type": "integer", "minimum": 1, "maximum": 200 },
              "role_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "checkpoints.get"
          }
        }
      },
      "then": {
        "properties": {
          "input": {
            "type": "object",
            "description": "G5 owner face: one checkpoint's full handoff summary body, todos, sources and decision references.",
            "properties": {
              "checkpoint_id": { "type": "string", "minLength": 1 }
            },
            "required": ["checkpoint_id"],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "requests.listInbox"
          }
        }
      },
      "then": {
        "properties": {
          "input": {
            "type": "object",
            "description": "G6 owner face: paged request read view with state/role/time filters. Projection only.",
            "properties": {
              "cursor": { "type": "string" },
              "limit": { "type": "integer", "minimum": 1, "maximum": 200 },
              "state": { "enum": ["accepted", "queued", "running", "awaiting_input", "completed", "failed", "cancelled", "expired"] },
              "target_role_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
              "created_since": { "type": "string", "format": "date-time" },
              "created_until": { "type": "string", "format": "date-time" }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "requests.get"
          }
        }
      },
      "then": {
        "properties": {
          "input": {
            "type": "object",
            "description": "G6 owner face: one request's full detail (question, budget, reported usage). Projection only.",
            "properties": {
              "request_id": { "type": "string", "minLength": 1 }
            },
            "required": ["request_id"],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "requests.cancelByOwner"
          }
        }
      },
      "then": {
        "properties": {
          "input": {
            "type": "object",
            "description": "G6 owner management cancellation (§6 matrix): independent owner principal + audit; idempotency_key optional per §5. Never borrows the initiating session identity.",
            "properties": {
              "request_id": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 },
              "idempotency_key": { "type": "string", "minLength": 1 }
            },
            "required": ["request_id", "reason"],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "requests.listCleanup"
          }
        }
      },
      "then": {
        "properties": {
          "input": {
            "type": "object",
            "description": "G6 owner face: reclamation view — terminal requests with cleanup_pending and cleanup_error (failure distinguishable, terminal state unchanged).",
            "properties": {
              "cursor": { "type": "string" },
              "limit": { "type": "integer", "minimum": 1, "maximum": 200 },
              "pending_only": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "artifacts.read"
          }
        }
      },
      "then": {
        "properties": {
          "input": {
            "type": "object",
            "description": "G6 owner face: one artifact's raw bytes + content_hash. Reading grants no write/publish right.",
            "properties": {
              "artifact_id": { "type": "string", "minLength": 1 }
            },
            "required": ["artifact_id"],
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
