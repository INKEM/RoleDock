{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:roledock:protocol:0.1:external-registration",
  "type": "object",
  "properties": {
    "host_session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "connection_subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "capability_ceiling": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "host_session_id",
    "connection_subject",
    "capability_ceiling"
  ],
  "additionalProperties": false
}
