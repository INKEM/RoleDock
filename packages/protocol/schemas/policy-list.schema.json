{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:roledock:protocol:0.1:policy-list",
  "title": "PolicyListPage",
  "description": "One page of the owner policy table (requested vs granted per role).",
  "type": "object",
  "properties": {
    "workspace_id": { "$ref": "#/$defs/id" },
    "observed_at": { "$ref": "#/$defs/timestamp" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role_id": { "$ref": "#/$defs/id" },
          "title": { "type": "string", "minLength": 1 },
          "requested": { "type": "array", "items": { "type": "string" } },
          "granted": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["role_id", "title", "requested", "granted"],
        "additionalProperties": false
      }
    },
    "next_cursor": { "type": ["string", "null"] }
  },
  "required": ["workspace_id", "observed_at", "items", "next_cursor"],
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}
