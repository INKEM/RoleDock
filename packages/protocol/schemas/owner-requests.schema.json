{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:roledock:protocol:0.1:owner-requests",
  "title": "OwnerRequestInboxPage",
  "description": "Owner read view of collaboration requests (desktop-gui-contract §2.3, G6): initiating/target, fixed binding, budget, REPORTED usage (null = unknown, never 0), result summary. Projection only.",
  "type": "object",
  "properties": {
    "workspace_id": { "$ref": "#/$defs/id" },
    "observed_at": { "$ref": "#/$defs/timestamp" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "request_id": { "type": "string", "minLength": 1 },
          "initiating": {
            "type": "object",
            "properties": {
              "session_id": { "type": "string", "minLength": 1 },
              "instance_id": { "type": "string", "minLength": 1 },
              "role_id": { "$ref": "#/$defs/id" }
            },
            "required": ["session_id", "instance_id", "role_id"],
            "additionalProperties": false
          },
          "target_role_id": { "$ref": "#/$defs/id" },
          "state": { "enum": ["accepted", "queued", "running", "awaiting_input", "completed", "failed", "cancelled", "expired"] },
          "execution_uncertain": { "type": "boolean" },
          "cleanup_pending": { "type": "boolean" },
          "binding": {
            "type": "object",
            "properties": {
              "target_generation": { "type": "integer", "minimum": 1 },
              "knowledge_revision": { "type": "integer", "minimum": 0 }
            },
            "required": ["target_generation", "knowledge_revision"],
            "additionalProperties": false
          },
          "budget": {
            "type": "object",
            "properties": {
              "max_turns": { "type": "integer", "minimum": 1 },
              "deadline": { "$ref": "#/$defs/timestamp" }
            },
            "additionalProperties": false
          },
          "usage": {
            "type": "object",
            "properties": {
              "output_bytes": { "type": ["integer", "null"], "minimum": 0 },
              "turns_reserved": { "type": ["integer", "null"], "minimum": 0 }
            },
            "required": ["output_bytes", "turns_reserved"],
            "additionalProperties": false,
            "description": "null = not reported yet; never rendered as 0."
          },
          "result": {
            "type": ["object", "null"],
            "properties": {
              "artifact_id": { "type": "string", "minLength": 1 },
              "content_hash": { "$ref": "#/$defs/sha256" },
              "summary": { "type": "string" }
            },
            "required": ["artifact_id", "content_hash"],
            "additionalProperties": false
          },
          "created_at": { "$ref": "#/$defs/timestamp" },
          "updated_at": { "$ref": "#/$defs/timestamp" },
          "terminal_at": { "type": ["string", "null"] },
          "question_preview": { "type": "string" }
        },
        "required": [
          "request_id", "initiating", "target_role_id", "state", "execution_uncertain", "cleanup_pending",
          "binding", "budget", "usage", "result", "created_at", "updated_at", "terminal_at", "question_preview"
        ],
        "additionalProperties": false
      }
    },
    "next_cursor": { "type": ["string", "null"] }
  },
  "required": ["workspace_id", "observed_at", "items", "next_cursor"],
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
