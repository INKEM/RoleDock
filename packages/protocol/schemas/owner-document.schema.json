{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:roledock:protocol:0.1:owner-document",
  "title": "OwnerDocumentRead",
  "description": "Owner read of one document revision (desktop-gui-contract §2.3, G5). public/project bodies ride along; private/role bodies stay at the metadata + content_hash layer (§3.2) with body_included:false — never a partial or scrubbed body. content_hash is over the original bytes.",
  "type": "object",
  "properties": {
    "workspace_id": { "$ref": "#/$defs/id" },
    "observed_at": { "$ref": "#/$defs/timestamp" },
    "role_id": { "$ref": "#/$defs/id" },
    "document_key": { "$ref": "#/$defs/id" },
    "revision": { "type": "integer", "minimum": 1 },
    "visibility": { "enum": ["private", "role", "project", "public"] },
    "content_hash": { "$ref": "#/$defs/sha256" },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "created_by_instance_id": { "type": ["string", "null"] },
    "body_included": { "type": "boolean" },
    "body": { "type": ["string", "null"] }
  },
  "required": [
    "workspace_id", "observed_at", "role_id", "document_key", "revision", "visibility",
    "content_hash", "created_at", "created_by_instance_id", "body_included", "body"
  ],
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
