{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:roledock:protocol:0.1:owner-request-detail",
  "title": "OwnerRequestDetail",
  "description": "Owner read of one request (desktop-gui-contract §2.3, G6): full question (including appended clarification turns), budget and reported usage. Projection only.",
  "type": "object",
  "properties": {
    "workspace_id": { "$ref": "#/$defs/id" },
    "observed_at": { "$ref": "#/$defs/timestamp" },
    "request_id": { "type": "string", "minLength": 1 },
    "idempotency_key": { "type": "string", "minLength": 1 },
    "initiating": {
      "type": "object",
      "properties": {
        "session_id": { "type": "string", "minLength": 1 },
        "instance_id": { "type": "string", "minLength": 1 },
        "role_id": { "$ref": "#/$defs/id" }
      },
      "required": ["session_id", "instance_id", "role_id"],
      "additionalProperties": false
    },
    "target_role_id": { "$ref": "#/$defs/id" },
    "state": { "enum": ["accepted", "queued", "running", "awaiting_input", "completed", "failed", "cancelled", "expired"] },
    "execution_uncertain": { "type": "boolean" },
    "cleanup_pending": { "type": "boolean" },
    "binding": {
      "type": "object",
      "properties": {
        "target_generation": { "type": "integer", "minimum": 1 },
        "knowledge_revision": { "type": "integer", "minimum": 0 }
      },
      "required": ["target_generation", "knowledge_revision"],
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "properties": {
        "max_turns": { "type": "integer", "minimum": 1 },
        "deadline": { "$ref": "#/$defs/timestamp" }
      },
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "properties": {
        "output_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "turns_reserved": { "type": ["integer", "null"], "minimum": 0 }
      },
      "required": ["output_bytes", "turns_reserved"],
      "additionalProperties": false
    },
    "question": { "type": "string" },
    "result": {
      "type": ["object", "null"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "content_hash": { "$ref": "#/$defs/sha256" },
        "summary": { "type": "string" }
      },
      "required": ["artifact_id", "content_hash"],
      "additionalProperties": false
    },
    "error": {
      "type": ["object", "null"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      },
      "required": ["code", "message"],
      "additionalProperties": false
    },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "updated_at": { "$ref": "#/$defs/timestamp" },
    "terminal_at": { "type": ["string", "null"] }
  },
  "required": [
    "workspace_id", "observed_at", "request_id", "idempotency_key", "initiating", "target_role_id",
    "state", "execution_uncertain", "cleanup_pending", "binding", "budget", "usage", "question",
    "result", "error", "created_at", "updated_at", "terminal_at"
  ],
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
