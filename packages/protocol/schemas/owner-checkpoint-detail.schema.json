{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:roledock:protocol:0.1:owner-checkpoint-detail",
  "title": "OwnerCheckpointDetail",
  "description": "Owner read of one checkpoint (desktop-gui-contract §2.3, G5): the full handoff summary body (a handoff product the role explicitly wrote — §3.2 full text), todos, sources, user decision references and document snapshots. References to private/role documents stay references; their bodies do not ride along.",
  "type": "object",
  "properties": {
    "workspace_id": { "$ref": "#/$defs/id" },
    "observed_at": { "$ref": "#/$defs/timestamp" },
    "checkpoint_id": { "type": "string", "minLength": 1 },
    "role_id": { "$ref": "#/$defs/id" },
    "generation": { "type": "integer", "minimum": 1 },
    "knowledge_revision": { "type": "integer", "minimum": 0 },
    "document_snapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "document_key": { "$ref": "#/$defs/id" },
          "revision": { "type": "integer", "minimum": 1 },
          "content_hash": { "$ref": "#/$defs/sha256" }
        },
        "required": ["document_key", "revision", "content_hash"],
        "additionalProperties": false
      }
    },
    "handoff_summary": {
      "type": "object",
      "properties": {
        "format": { "enum": ["markdown"] },
        "body": { "type": "string" },
        "content_hash": { "$ref": "#/$defs/sha256" }
      },
      "required": ["format", "body", "content_hash"],
      "additionalProperties": false
    },
    "user_decision_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "summary": { "type": "string", "minLength": 1 },
          "document_key": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
          "revision": { "type": "integer", "minimum": 1 }
        },
        "required": ["summary"],
        "additionalProperties": false
      }
    },
    "todos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": { "type": "string", "minLength": 1 },
          "done": { "type": "boolean" }
        },
        "required": ["description", "done"],
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": { "enum": ["document", "request", "external"] },
          "document_key": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
          "revision": { "type": "integer", "minimum": 1 },
          "description": { "type": "string" }
        },
        "required": ["kind"],
        "additionalProperties": false
      }
    },
    "created_by_instance_id": { "type": "string", "minLength": 1 },
    "created_at": { "$ref": "#/$defs/timestamp" }
  },
  "required": [
    "workspace_id", "observed_at", "checkpoint_id", "role_id", "generation", "knowledge_revision",
    "document_snapshots", "handoff_summary", "user_decision_refs", "todos", "sources",
    "created_by_instance_id", "created_at"
  ],
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
