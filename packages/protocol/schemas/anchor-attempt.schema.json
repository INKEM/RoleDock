{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:roledock:protocol:0.1:anchor-attempt",
  "title": "anchor-attempt",
  "type": "object",
  "properties": {
    "attempt_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "external_session_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "authorization_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "input_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "bundle_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "load_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "source_generation": {
      "type": "integer",
      "minimum": 0
    },
    "source_knowledge_revision": {
      "type": "integer",
      "minimum": 0
    },
    "state": {
      "enum": [
        "prepared",
        "loading",
        "uncertain",
        "active",
        "failed"
      ]
    },
    "confirmation": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "host_session_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "load_key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "content_hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "load_version": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "host_session_id",
            "load_key",
            "content_hash",
            "load_version"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "code": {
              "enum": [
                "NOT_IMPLEMENTED",
                "VALIDATION_FAILED",
                "NOT_FOUND",
                "PERMISSION_DENIED",
                "ROLE_ALREADY_EXISTS",
                "ROLE_UNINITIALIZED",
                "GENERATION_CONFLICT",
                "REVISION_CONFLICT",
                "INVALID_STATE_TRANSITION",
                "IDEMPOTENCY_CONFLICT",
                "REQUEST_NOT_TERMINABLE",
                "ADAPTER_CAPABILITY_MISSING",
                "WORKSPACE_LOCKED",
                "INTERNAL"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "attempt_id",
    "external_session_id",
    "authorization_id",
    "idempotency_key",
    "input_hash",
    "bundle_hash",
    "load_key",
    "source_generation",
    "source_knowledge_revision",
    "state",
    "confirmation",
    "error",
    "created_at"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "active"
          }
        }
      },
      "then": {
        "properties": {
          "confirmation": {
            "type": "object",
            "properties": {
              "host_session_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "load_key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "content_hash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "load_version": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "host_session_id",
              "load_key",
              "content_hash",
              "load_version"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "failed"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "enum": [
                  "NOT_IMPLEMENTED",
                  "VALIDATION_FAILED",
                  "NOT_FOUND",
                  "PERMISSION_DENIED",
                  "ROLE_ALREADY_EXISTS",
                  "ROLE_UNINITIALIZED",
                  "GENERATION_CONFLICT",
                  "REVISION_CONFLICT",
                  "INVALID_STATE_TRANSITION",
                  "IDEMPOTENCY_CONFLICT",
                  "REQUEST_NOT_TERMINABLE",
                  "ADAPTER_CAPABILITY_MISSING",
                  "WORKSPACE_LOCKED",
                  "INTERNAL"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
