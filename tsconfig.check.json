{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": {
      "@roledock/protocol": [
        "packages/protocol/src/index.ts"
      ],
      "@roledock/core": [
        "packages/core/src/index.ts"
      ],
      "@roledock/cli": [
        "packages/cli/src/index.ts"
      ],
      "@roledock/adapter-mock": [
        "adapters/mock/src/index.ts"
      ],
      "@roledock/adapter-process-bridge": [
        "adapters/process-bridge/src/index.ts"
      ],
      "@roledock/service": [
        "packages/service/src/index.ts"
      ],
      "@roledock/mcp": [
        "packages/mcp/src/index.ts"
      ],
      "@roledock/adapter-zcode": [
        "adapters/zcode/src/index.ts"
      ]
    }
  },
  "include": [
    "vitest.config.ts",
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "adapters/*/src/**/*.ts",
    "adapters/*/test/**/*.ts",
    "tests/**/*.ts"
  ]
}
