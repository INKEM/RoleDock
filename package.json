{
  "name": "roledock",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "RoleDock: a framework for persistent agent roles, document-based knowledge, session handoff, and isolated collaboration across harnesses.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "22.23.2",
    "npm": ">=10.9.8"
  },
  "workspaces": [
    "packages/*",
    "adapters/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --force && tsc -p tsconfig.check.json",
    "test": "npm run build && vitest run",
    "check": "npm run typecheck && npm run test",
    "clean": "tsc -b --clean && rm -rf packages/*/dist"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "5.0.4",
    "yaml": "2.9.1"
  }
}
